{
  "uid": "backlot-__SLUG__",
  "title": "Backlot: __TITLE__",
  "tags": ["backlot", "__SLUG__"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {"from": "now-6h", "to": "now"},
  "annotations": {"list": [
    {"name": "Director's notes", "datasource": {"type": "grafana", "uid": "-grafana-"}, "enable": true,
     "iconColor": "#F2CC0C", "target": {"type": "tags", "tags": ["backlot", "__SLUG__"], "matchAny": false}}
  ]},
  "panels": [
    {"type": "stat", "title": "Shooting day", "gridPos": {"x": 0, "y": 0, "w": 4, "h": 4},
     "datasource": {"type": "prometheus", "uid": "__PROM__"},
     "targets": [{"expr": "backlot_day{project=\"__SLUG__\"}", "instant": true}]},
    {"type": "stat", "title": "Scenes complete", "gridPos": {"x": 4, "y": 0, "w": 5, "h": 4},
     "datasource": {"type": "prometheus", "uid": "__PROM__"},
     "targets": [{"expr": "backlot_scenes_completed{project=\"__SLUG__\"}", "instant": true, "refId": "A"},
                 {"expr": "backlot_scenes_total{project=\"__SLUG__\"}", "instant": true, "refId": "B"}]},
    {"type": "gauge", "title": "Today's pages: shot vs planned", "gridPos": {"x": 9, "y": 0, "w": 6, "h": 4},
     "datasource": {"type": "prometheus", "uid": "__PROM__"},
     "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100,
       "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "orange", "value": 60}, {"color": "green", "value": 85}]}}},
     "targets": [{"expr": "100 * backlot_eighths_completed_today{project=\"__SLUG__\"} / clamp_min(backlot_eighths_planned_today{project=\"__SLUG__\"}, 1)", "instant": true}]},
    {"type": "stat", "title": "Budget spent vs planned", "gridPos": {"x": 15, "y": 0, "w": 9, "h": 4},
     "datasource": {"type": "prometheus", "uid": "__PROM__"},
     "fieldConfig": {"defaults": {"unit": "currencyUSD"}},
     "targets": [{"expr": "backlot_budget_spent_usd{project=\"__SLUG__\"}", "instant": true, "refId": "A"},
                 {"expr": "backlot_budget_planned_usd{project=\"__SLUG__\"}", "instant": true, "refId": "B"}]},
    {"type": "timeseries", "title": "Pages shot per day (eighths)", "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "__PROM__"},
     "targets": [{"expr": "backlot_eighths_completed_today{project=\"__SLUG__\"}", "legendFormat": "shot"},
                 {"expr": "backlot_eighths_planned_today{project=\"__SLUG__\"}", "legendFormat": "planned"}]},
    {"type": "barchart", "title": "Minutes lost by cause", "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "__PROM__"},
     "options": {"orientation": "horizontal"},
     "targets": [{"expr": "sum by (cause) (backlot_delay_minutes{project=\"__SLUG__\"})", "instant": true, "legendFormat": "{{cause}}", "format": "table"}]},
    {"type": "timeseries", "title": "Takes and setups", "gridPos": {"x": 0, "y": 12, "w": 12, "h": 7},
     "datasource": {"type": "prometheus", "uid": "__PROM__"},
     "targets": [{"expr": "backlot_takes_total{project=\"__SLUG__\"}", "legendFormat": "takes"},
                 {"expr": "backlot_setups_total{project=\"__SLUG__\"}", "legendFormat": "setups"}]},
    {"type": "logs", "title": "Production log", "gridPos": {"x": 12, "y": 12, "w": 12, "h": 7},
     "datasource": {"type": "loki", "uid": "__LOKI__"},
     "options": {"showTime": true, "wrapLogMessage": true, "sortOrder": "Descending"},
     "targets": [{"expr": "{service_name=\"backlot\"} | project=\"__SLUG__\""}]}
  ]
}
