# --- Gemini / Google Cloud -------------------------------------------------
GEMINI_MODEL=gemini-3.8-flash            # any current Gemini Flash id works
GOOGLE_GENAI_USE_VERTEXAI=TRUE           # FALSE to use a Gemini API key instead
GOOGLE_CLOUD_PROJECT=your-project
GOOGLE_CLOUD_LOCATION=us-central1
# GOOGLE_API_KEY=                         # only when GOOGLE_GENAI_USE_VERTEXAI=FALSE

# --- Grafana (Cloud or local) --------------------------------------------
GRAFANA_URL=https://yourstack.grafana.net
GRAFANA_SERVICE_ACCOUNT_TOKEN=glsa_...    # Editor role: dashboards + annotations write
PROMETHEUS_DATASOURCE=grafanacloud-yourstack-prom
LOKI_DATASOURCE=grafanacloud-yourstack-logs

# --- Grafana MCP server ----------------------------------------------------
# Either a streamable-http endpoint (docker compose / Cloud Run sidecar) ...
MCP_GRAFANA_URL=http://localhost:8000/mcp
MCP_GRAFANA_SERVER_TOKEN=change-me
# ... or a local binary over stdio (go install github.com/grafana/mcp-grafana/cmd/mcp-grafana@latest)
# MCP_GRAFANA_COMMAND=mcp-grafana

# --- Telemetry push (OTLP/HTTP) --------------------------------------------
# Grafana Cloud: one gateway, Basic auth with "<instance id>:<token>" base64-encoded
OTLP_METRICS_ENDPOINT=https://otlp-gateway-prod-eu-west-2.grafana.net/otlp/v1/metrics
OTLP_LOGS_ENDPOINT=https://otlp-gateway-prod-eu-west-2.grafana.net/otlp/v1/logs
OTLP_AUTH_HEADER=Basic base64instanceid:token
# Local docker compose instead:
# OTLP_METRICS_ENDPOINT=http://localhost:9090/api/v1/otlp/v1/metrics
# OTLP_LOGS_ENDPOINT=http://localhost:3100/otlp/v1/logs

BACKLOT_DATA_DIR=data
